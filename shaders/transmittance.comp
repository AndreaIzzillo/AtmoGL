#version 430 core

#include "atmosphere_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 0) uniform image2D uTransmittanceLutImage;

vec3 computeTransmittanceToTop(float r, float mu)
{
    const int sampleCount = 40;

    float distanceToTop = distanceToAtmosphereExit(r, mu);
    if (distanceToTop <= 0.0)
        return vec3(1.0);

    float stepLength = distanceToTop / float(sampleCount);

    vec3 origin = vec3(0.0, r, 0.0);
    vec3 direction = vec3(
        sqrt(max(0.0, 1.0 - mu * mu)),
        mu,
        0.0
    );

    vec3 opticalDepth = vec3(0.0);

    for (int i = 0; i < sampleCount; ++i)
    {
        float t = (float(i) + 0.5) * stepLength;
        vec3 position = origin + t * direction;
        float altitude = length(position) - uGroundRadius;

        // ∫(σt(x)) 
        opticalDepth += evaluateExtinction(altitude) * stepLength;
    }

    // T(x, x + tatmoli) = exp(-∫(σt(x)))
    return exp(-opticalDepth);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lutSize = imageSize(uTransmittanceLutImage);
    if (any(greaterThanEqual(pixel, lutSize)))
        return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(lutSize);
    vec2 rMu = transmittanceUvToRMu(uv, lutSize);
    vec3 transmittance = computeTransmittanceToTop(rMu.x, rMu.y);

    imageStore(uTransmittanceLutImage, pixel, vec4(transmittance, 1.0));
}
