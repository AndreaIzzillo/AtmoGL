#version 430 core

#include "atmosphere_common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba16f, binding = 1) uniform image2D uSkyViewLut;

uniform vec3 uCameraPosition;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lutSize = imageSize(uSkyViewLut);

    if (any(greaterThanEqual(pixel, lutSize)))
        return;

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(lutSize);
    vec3 direction = skyViewUvToDirection(uv, uCameraPosition, lutSize);
    AtmosphereResult result = integrateAtmosphere(
        uCameraPosition,
        direction,
        2.0 * uTopRadius
    );

    imageStore(uSkyViewLut, pixel, vec4(result.radiance, 1.0));
}
