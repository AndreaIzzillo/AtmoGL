#version 430 core

#include "atmosphere_common.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba16f, binding = 2) uniform image3D uAerialPerspectiveLut;

uniform mat4 uInverseProjection;
uniform mat4 uInverseView;
uniform vec3 uCameraPosition;
uniform float uAerialPerspectiveMaxDepth;

void main()
{
    ivec3 voxel = ivec3(gl_GlobalInvocationID.xyz);
    ivec3 lutSize = imageSize(uAerialPerspectiveLut);

    if (any(greaterThanEqual(voxel, lutSize)))
        return;

    vec2 uv = (vec2(voxel.xy) + vec2(0.5)) / vec2(lutSize.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    vec4 cameraPoint = uInverseProjection * vec4(ndc, -1.0, 1.0);
    vec3 cameraDirection = normalize(cameraPoint.xyz / cameraPoint.w);
    vec3 worldDirection = normalize(mat3(uInverseView) * cameraDirection);
    float depthCoordinate = float(voxel.z) / float(lutSize.z - 1);
    float viewDepth = depthCoordinate * uAerialPerspectiveMaxDepth;
    float distanceAlongRay = viewDepth / -cameraDirection.z;

    AtmosphereResult result = integrateAtmosphere(
        uCameraPosition,
        worldDirection,
        distanceAlongRay
    );

    float transmittance = dot(result.transmittance, vec3(1.0 / 3.0));

    imageStore(
        uAerialPerspectiveLut,
        voxel,
        vec4(result.radiance, transmittance)
    );
}